APP_NAME=VideoAuto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Optional: defaults to the creative-projects folder in the repository root.
# CREATIVE_PROJECTS_ROOT=/absolute/path/to/creative-projects

# The creative workspace is intentionally restricted to this machine.
CREATIVE_ACCESS_MODE=local

# Creative AI providers
# "auto" uses OpenRouter for text when its key exists and otherwise keeps the
# local simulation. Use "simulation" to guarantee that no generation API runs.
CREATIVE_GENERATION_DRIVER=simulation
CREATIVE_LIGHTWEIGHT_MODE=true
CREATIVE_REQUEST_TIMEOUT=180

# Local deterministic media. `sync` keeps manual and automatic simulation
# immediate; `queue` leaves a pending job for a Laravel worker to claim.
CREATIVE_MEDIA_EXECUTION=sync
CREATIVE_MEDIA_QUEUE=creative-media
CREATIVE_MEDIA_TIMEOUT=30
CREATIVE_FFMPEG_BINARY=ffmpeg
CREATIVE_FFPROBE_BINARY=ffprobe
CREATIVE_RENDER_EXECUTION=sync
CREATIVE_RENDER_QUEUE=creative-render
CREATIVE_RENDER_TIMEOUT=90

# OpenRouter: GPT-5.6 Sol structures ideas/scripts; Fable 5 polishes script prose.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STRUCTURE_MODEL=openai/gpt-5.6-sol
OPENROUTER_POLISH_MODEL=anthropic/claude-fable-5
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MAX_TOKENS=2200
OPENROUTER_HTTP_REFERER="${APP_URL}"
OPENROUTER_APP_NAME="${APP_NAME}"

# fal.ai: Seedance 2.0 Fast uses the cheapest 480p, four-second preview settings.
FAL_KEY=
FAL_BASE_URL=https://fal.run
FAL_PLATFORM_BASE_URL=https://api.fal.ai/v1
FAL_SEEDANCE_MODEL=bytedance/seedance-2.0/fast/text-to-video
FAL_SEEDANCE_IMAGE_MODEL=bytedance/seedance-2.0/fast/image-to-video
FAL_SEEDANCE_RESOLUTION=480p
FAL_SEEDANCE_DURATION=4
FAL_SEEDANCE_ASPECT_RATIO="9:16"
FAL_SEEDANCE_GENERATE_AUDIO=false

# ElevenLabs: add a Voice ID from your ElevenLabs voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
